# Google API Credentials
GOOGLE_CLIENT_ID=client_id_here
GOOGLE_CLIENT_SECRET=client_secret_here
GOOGLE_REFRESH_TOKEN=refresh_token_here
GOOGLE_MAPS_API_KEY=google_maps_api_key_here

# This key is for client-side Google Maps Embed
VITE_GOOGLE_MAPS_API_KEY=google_maps_api_key_here

# MailerSend API Key
MAILERSEND_API_KEY=mailersend_api_key_here

# Twilio credentials for SMS and WhatsApp
TWILIO_ACCOUNT_SID=account_sid_here
TWILIO_AUTH_TOKEN=auth_token_here
TWILIO_PHONE_NUMBER=phone_number_here
TWILIO_WHATSAPP_NUMBER=whatsapp_number_here

# Simulation mode settings
WHATSAPP_SIMULATION_MODE=true
SMS_SIMULATION_MODE=false
SMS_BYPASS_VERIFICATION=true