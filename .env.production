# Ambiente (não alterar)
NODE_ENV=production

# Banco de dados (Obrigatório)
DATABASE_URL=postgres://seu_usuario:sua_senha@seu_host.neon.tech/seu_banco

# Autenticação (Obrigatório)
JWT_SECRET=uma_string_secreta_longa_e_aleatoria

# Google API (Opcional - necessário para mapa e email)
GOOGLE_CLIENT_ID=seu_client_id
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REFRESH_TOKEN=seu_refresh_token
GOOGLE_MAPS_API_KEY=sua_api_key
VITE_GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY}

# Twilio para SMS e WhatsApp (Opcional)
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_PHONE_NUMBER=seu_phone_number
TWILIO_WHATSAPP_NUMBER=seu_whatsapp_number

# Configurações de simulação
WHATSAPP_SIMULATION_MODE=true
SMS_SIMULATION_MODE=true
SMS_BYPASS_VERIFICATION=true

# URL da aplicação (será definido automaticamente pela Vercel)
# VERCEL_URL=

# Customização do domínio (se aplicável)
# APP_DOMAIN=logmene.com.br